          "name": "Get all model point fields for a product.",
          "request": {
            "name": "Get all model point fields for a product.",
            "description": {
              "content": "This endpoint will:\n- Validate the user has permission to view the model\n- Return all model point fields for the specified product\n- Support pagination with offset and limit\n- Support field filtering via the Fields parameter\n- Include Field Name, Field ID, Data Type, IsRequired flag, Scales flags, Default values, and Aliases",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "Products",
                ":ProductId",
                "ModelPointFields"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "Fields",
                  "value": "<string>",
                  "description": "Optional parameter to filter the top-level fields that are returned. \nThe list must be in CSV format. Example: field1,field2,field3"
                },
                {
                  "disabled": false,
                  "key": "Limit",
                  "value": "<integer>",
                  "description": "Optional parameter to limit the number of items returned. Default is 200."
                },
                {
                  "disabled": false,
                  "key": "Offset",
                  "value": "<integer>",
                  "description": "Optional parameter to offset the items returned. Default is 0."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "ProductId",
                  "description": "(Required) The ID of the product to get model point fields for."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
            "auth": {
